# --- OpenAI (obligatoire) ---
# Clé API OpenAI. Jamais codée en dur : elle est lue ici depuis l'environnement.
OPENAI_API_KEY=sk-votre-cle-openai

# Modèle à utiliser. Défaut applicatif : gpt-5.5.
# Mettez ici un modèle disponible sur votre compte si gpt-5.5 ne l'est pas
# (ex: gpt-4o, gpt-4.1, gpt-5, ...).
OPENAI_MODEL=gpt-5.5

# Optionnel : base URL personnalisée (proxy / Azure compatible OpenAI).
# OPENAI_BASE_URL=

# --- Infoclimat (observations temps réel, optionnel mais recommandé) ---
# Token de l'API publique Infoclimat (https://www.infoclimat.fr/public-api/).
# Sans token, l'app fonctionne mais signale que les observations ne sont pas
# disponibles (elle n'invente jamais de donnée).
INFOCLIMAT_TOKEN=

# Optionnel : forcer une liste de stations Infoclimat (IDs séparés par des
# virgules). Par défaut, l'app choisit la/les station(s) SYNOP la/les plus
# proche(s) de la localisation demandée.
# INFOCLIMAT_STATIONS=07156,07149

# --- Réseau ---
# Délai d'expiration HTTP (secondes).
HTTP_TIMEOUT=20
